+// ---- Anki Connection API ----
+
+void CrossPointWebServer::handleGetAnkiConfig() const {
+  std::string error;
+  if (!ANKI_STORE.loadConfiguration(error)) {
+    server->send(500, "text/plain", error.c_str());
+    return;
+  }
+
+  JsonDocument doc;
+  doc["serverUrl"] = ANKI_STORE.getServerUrl();
+  doc["hasApiToken"] = !ANKI_STORE.getApiToken().empty();
+  doc["configured"] = ANKI_STORE.configured();
+  doc["maxCardsPerDeck"] = ANKI_STORE.getMaxCardsPerDeck();
+  doc["maxCardsTotal"] = ANKI_STORE.getMaxCardsTotal();
+  doc["useReaderFont"] = ANKI_STORE.usesReaderFont();
+
+  String json;
+  serializeJson(doc, json);
+  server->send(200, "application/json", json);
+  LOG_DBG("WEB", "Served Anki configuration API");
+}
+
+void CrossPointWebServer::handlePostAnkiConfig() {
+  if (!server->hasArg("plain")) {
+    server->send(400, "text/plain", "Missing JSON body");
+    return;
+  }
+
+  JsonDocument doc;
+  const DeserializationError parseError = deserializeJson(doc, server->arg("plain"));
+  if (parseError) {
+    server->send(400, "text/plain", String("Invalid JSON: ") + parseError.c_str());
+    return;
+  }
+  if (!doc.is<JsonObject>()) {
+    server->send(400, "text/plain", "JSON body must be an object");
+    return;
+  }
+
+  std::string error;
+  if (!ANKI_STORE.loadConfiguration(error)) {
+    server->send(500, "text/plain", error.c_str());
+    return;
+  }
+
+  const std::string previousServerUrl = ANKI_STORE.getServerUrl();
+  const std::string previousApiToken = ANKI_STORE.getApiToken();
+  const uint16_t previousMaxPerDeck = ANKI_STORE.getMaxCardsPerDeck();
+  const uint16_t previousMaxTotal = ANKI_STORE.getMaxCardsTotal();
+  const bool previousUseReaderFont = ANKI_STORE.usesReaderFont();
+  bool changed = false;
+
+  if (doc["serverUrl"].is<const char*>() || doc["serverUrl"].is<std::string>()) {
+    const std::string serverUrl = doc["serverUrl"].as<std::string>();
+    if (!validAnkiServerUrl(serverUrl)) {
+      server->send(400, "text/plain", "Server URL must be a valid http:// or https:// base URL");
+      return;
+    }
+    ANKI_STORE.setServerUrl(serverUrl);
+    changed = ANKI_STORE.getServerUrl() != previousServerUrl;
+  }
+
+  if (doc["apiToken"].is<const char*>() || doc["apiToken"].is<std::string>()) {
+    const std::string apiToken = doc["apiToken"].as<std::string>();
+    if (apiToken.size() < 16 || apiToken.size() > 256 || apiToken.find_first_of(" \t\r\n") != std::string::npos) {
+      ANKI_STORE.setServerUrl(previousServerUrl);
+      server->send(400, "text/plain", "API token must contain 16 to 256 characters");
+      return;
+    }
+    ANKI_STORE.setApiToken(apiToken);
+    changed = changed || ANKI_STORE.getApiToken() != previousApiToken;
+  }
+
+  if (doc["maxCardsPerDeck"].is<int>() || doc["maxCardsPerDeck"].is<unsigned int>()) {
+    const int value = doc["maxCardsPerDeck"].as<int>();
+    if (value < 1 || value > 1000) {
+      ANKI_STORE.setServerUrl(previousServerUrl);
+      ANKI_STORE.setApiToken(previousApiToken);
+      server->send(400, "text/plain", "maxCardsPerDeck must be between 1 and 1000");
+      return;
+    }
+    ANKI_STORE.setMaxCardsPerDeck(static_cast<uint16_t>(value));
+    changed = changed || ANKI_STORE.getMaxCardsPerDeck() != previousMaxPerDeck;
+  }
+
+  if (doc["maxCardsTotal"].is<int>() || doc["maxCardsTotal"].is<unsigned int>()) {
+    const int value = doc["maxCardsTotal"].as<int>();
+    if (value < 1 || value > 1000) {
+      ANKI_STORE.setServerUrl(previousServerUrl);
+      ANKI_STORE.setApiToken(previousApiToken);
+      ANKI_STORE.setMaxCardsPerDeck(previousMaxPerDeck);
+      ANKI_STORE.setMaxCardsTotal(previousMaxTotal);
+      server->send(400, "text/plain", "maxCardsTotal must be between 1 and 1000");
+      return;
+    }
+    ANKI_STORE.setMaxCardsTotal(static_cast<uint16_t>(value));
+    changed = changed || ANKI_STORE.getMaxCardsTotal() != previousMaxTotal;
+  }
+
+  if (doc["useReaderFont"].is<bool>() || doc["useReaderFont"].is<int>() || doc["useReaderFont"].is<unsigned int>()) {
+    const bool value = doc["useReaderFont"].as<bool>() || doc["useReaderFont"].as<int>() != 0;
+    ANKI_STORE.setUseReaderFont(value);
+    changed = changed || ANKI_STORE.usesReaderFont() != previousUseReaderFont;
+  }
+
+  if (!changed) {
+    server->send(200, "text/plain", "No Anki settings changed");
+    return;
+  }
+
+  if (!ANKI_STORE.saveConfig(error)) {
+    ANKI_STORE.setServerUrl(previousServerUrl);
+    ANKI_STORE.setApiToken(previousApiToken);
+    ANKI_STORE.setMaxCardsPerDeck(previousMaxPerDeck);
+    ANKI_STORE.setMaxCardsTotal(previousMaxTotal);
+    ANKI_STORE.setUseReaderFont(previousUseReaderFont);
+    server->send(500, "text/plain", error.c_str());
+    return;
+  }
+
+  server->send(200, "text/plain", "Anki settings saved");
+  LOG_DBG("WEB", "Saved Anki settings (URL/token/limits/font)");
+}
