+++ b/src/anki/AnkiSyncClient.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <string>
+
+class AnkiSyncClient {
+ public:
+  enum class Error {
+    OK = 0,
+    NOT_CONFIGURED,
+    LOCAL_REVIEWS_PENDING,
+    NO_REVIEWS,
+    INVALID_URL,
+    NETWORK_ERROR,
+    AUTH_FAILED,
+    SERVER_ERROR,
+    PROTOCOL_ERROR,
+    STORAGE_ERROR,
+    RESPONSE_TOO_LARGE,
+    PARTIAL_RESPONSE,
+  };
+
+  static Error pull(std::string& detail);
+  static Error push(std::string& detail);
+  static const char* errorString(Error error);
+  static int lastHttpCode;
+};
diff --git a/src/components/icons/anki.h b/src/components/icons/anki.h
new file mode 100644
index 0000000..b778d45
--- /dev/null
+++ b/src/components/icons/anki.h
@@ -0,0 +1,12 @@
+#pragma once
+#include <cstdint>
+
+// size: 32x32 — stacked flashcards for Anki home menu
