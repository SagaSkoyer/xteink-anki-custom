+bool validAnkiServerUrl(const std::string& value) {
+  constexpr size_t MAX_SERVER_URL_LENGTH = 255;
+  if (value.empty() || value.size() > MAX_SERVER_URL_LENGTH || value.find_first_of(" \t\r\n") != std::string::npos) {
+    return false;
+  }
+
+  size_t schemeLength = 0;
+  if (value.rfind("http://", 0) == 0) {
+    schemeLength = 7;
+  } else if (value.rfind("https://", 0) == 0) {
+    schemeLength = 8;
+  } else {
+    return false;
+  }
+
+  return value.size() > schemeLength && value.find_first_of("?#", schemeLength) == std::string::npos;
+}
