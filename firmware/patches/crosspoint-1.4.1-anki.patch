diff --git a/lib/EpdFont/scripts/convert-builtin-fonts.sh b/lib/EpdFont/scripts/convert-builtin-fonts.sh
index a259603..110fe88 100755
--- a/lib/EpdFont/scripts/convert-builtin-fonts.sh
+++ b/lib/EpdFont/scripts/convert-builtin-fonts.sh
@@ -41,9 +41,21 @@ for size in ${UI_FONT_SIZES[@]}; do
     # are filled from it while every glyph Ubuntu already has stays unchanged
     # (fontstack is ordered by descending priority).
     viet_path="../builtinFonts/source/Ubuntu/Ubuntu-Vietnamese-${style}.ttf"
+    font_stack=("$font_path" "$hebrew_path" "$viet_path")
+    additional_intervals=(--additional-intervals 0x05D0,0x05EA)
+    if [[ "$size" -eq 12 ]]; then
+      # Anki uses UI_12 for card text. Keep Ubuntu's appearance, but fill
+      # uncommon Greek punctuation/symbols from Noto Sans and include both
+      # modern and polytonic Greek.
+      font_stack+=("../builtinFonts/source/NotoSans/NotoSans-${style}.ttf")
+      additional_intervals+=(
+        --additional-intervals 0x0370,0x03FF
+        --additional-intervals 0x1F00,0x1FFF
+      )
+    fi
     output_path="../builtinFonts/${font_name}.h"
-    python fontconvert.py $font_name $size $font_path $hebrew_path $viet_path \
-      --additional-intervals 0x05D0,0x05EA > $output_path
+    python fontconvert.py "$font_name" "$size" "${font_stack[@]}" \
+      "${additional_intervals[@]}" > "$output_path"
     echo "Generated $output_path"
   done
 done
